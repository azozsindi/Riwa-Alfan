rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Valid Document ID for single document operations
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict Email Verification Check (Anti-Email Spoofing)
    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Root Super Admin Gate:
    // Matches azozsindi23@gmail.com (case-insensitive)
    function isSuperAdmin() {
      return isSignedIn() 
        && isVerifiedUser()
        && request.auth.token.email != null 
        && (
          request.auth.token.email == 'azozsindi23@gmail.com' ||
          request.auth.token.email == 'AzozSindi23@gmail.com' ||
          request.auth.token.email.matches('(?i)^azozsindi23@gmail\\.com$')
        );
    }

    // General Admin Gate:
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        )
      );
    }

    // Booking Schema Validator with Strict Allowed Keys (Supports Legacy + Q&A Eligibility Fields)
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'interest', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'name', 'phone', 'phoneSuffix', 'interest', 'experience', 'timing', 'notes',
          'paymentMethod', 'paymentAmount', 'paymentReference', 'status', 'createdAt',
          'bookingType', 'selectedCourses', 'highestCert', 'issuingAgency', 'qaAnswers',
          'preliminaryEligibility', 'eligibilityStatus', 'equivalencyRequired',
          'instructorActionType', 'instructorReviewNote', 'paymentAllowed', 'reviewedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && (!('phoneSuffix' in data) || (data.phoneSuffix is string && data.phoneSuffix.size() <= 10))
        && data.interest is string && data.interest.size() <= 500
        && (!('experience' in data) || (data.experience is string && data.experience.size() <= 150))
        && (!('timing' in data) || (data.timing is string && data.timing.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('paymentAmount' in data) || (data.paymentAmount is string && data.paymentAmount.size() <= 100))
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120))
        && data.status in ['new', 'contacted', 'confirmed', 'completed', 'cancelled', 'paid', 'pending_payment']
        && (!('bookingType' in data) || (data.bookingType in ['courses', 'expedition', 'mixed']))
        && (!('selectedCourses' in data) || (data.selectedCourses is list && data.selectedCourses.size() <= 15 && (data.selectedCourses.size() == 0 || data.selectedCourses[0] is map)))
        && (!('highestCert' in data) || (data.highestCert in ['none', 'open_water', 'advanced_open_water', 'rescue_diver', 'divemaster', 'other']))
        && (!('issuingAgency' in data) || (data.issuingAgency in ['PADI', 'SSI', 'NAUI', 'SDI', 'RAID', 'CMAS', 'other', 'none']))
        && (!('qaAnswers' in data) || (data.qaAnswers is map && data.qaAnswers.keys().size() <= 15))
        && (!('preliminaryEligibility' in data) || (data.preliminaryEligibility in ['eligible', 'missing_requirements']))
        && (!('eligibilityStatus' in data) || (data.eligibilityStatus in ['eligible', 'missing_requirements', 'pending_instructor_review', 'approved', 'rejected']))
        && (!('equivalencyRequired' in data) || (data.equivalencyRequired is bool))
        && (!('instructorActionType' in data) || (data.instructorActionType in ['approved', 'request_info', 'request_requirement', 'rejected']))
        && (!('instructorReviewNote' in data) || (data.instructorReviewNote is string && data.instructorReviewNote.size() <= 1000))
        && (!('paymentAllowed' in data) || (data.paymentAllowed is bool))
        && (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 50))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Non-PII Public Status Projection Validator
    function isValidBookingStatus(data) {
      return data.keys().hasAll(['id', 'phoneSuffix', 'interest', 'eligibilityStatus', 'paymentAllowed', 'status', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'phoneSuffix', 'interest', 'eligibilityStatus', 'preliminaryEligibility',
          'paymentAllowed', 'instructorActionType', 'instructorReviewNote', 'paymentAmount',
          'status', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.phoneSuffix is string && data.phoneSuffix.size() <= 10
        && data.interest is string && data.interest.size() <= 500
        && data.eligibilityStatus in ['eligible', 'missing_requirements', 'pending_instructor_review', 'approved', 'rejected']
        && (!('preliminaryEligibility' in data) || (data.preliminaryEligibility in ['eligible', 'missing_requirements']))
        && data.paymentAllowed is bool
        && (!('instructorActionType' in data) || (data.instructorActionType in ['approved', 'request_info', 'request_requirement', 'rejected']))
        && (!('instructorReviewNote' in data) || (data.instructorReviewNote is string && data.instructorReviewNote.size() <= 1000))
        && (!('paymentAmount' in data) || (data.paymentAmount is string && data.paymentAmount.size() <= 100))
        && data.status in ['new', 'contacted', 'confirmed', 'completed', 'cancelled', 'paid', 'pending_payment']
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Admin Record Validator with Strict Allowed Keys
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'role', 'status', 'notes', 'createdAt', 'lastLoginAt'])
        && data.email is string && data.email.size() <= 150
        && data.role in ['superadmin', 'admin', 'instructor', 'viewer']
        && (!('name' in data) || (data.name is string && data.name.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('status' in data) || (data.status in ['active', 'suspended']))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50));
    }

    // Trainee Record Validator with Strict Allowed Keys
    function isValidTrainee(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'phone', 'email', 'course', 'status', 'padiNumber', 'notes', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('course' in data) || (data.course is string && data.course.size() <= 200))
        && (!('status' in data) || (data.status in ['active', 'completed', 'pending', 'paused']))
        && (!('padiNumber' in data) || (data.padiNumber is string && data.padiNumber.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // 1. Bookings Collection:
    // - Public visitors can ONLY submit new bookings with paymentAllowed == false and status == 'new'.
    // - Public visitors CANNOT approve requests or set paymentAllowed == true or status == 'paid'.
    // - Customer PII is strictly restricted to admins.
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId) 
        && isValidBooking(incoming()) 
        && incoming().id == bookingId
        && (
          isAdmin() ||
          (
            incoming().status == 'new'
            && (!('paymentAllowed' in incoming()) || incoming().paymentAllowed == false)
            && (!('eligibilityStatus' in incoming()) || incoming().eligibilityStatus == 'pending_instructor_review')
          )
        );
      allow update: if isValidId(bookingId) && isAdmin() && isValidBooking(incoming()) && incoming().id == existing().id;
      allow get, delete: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();
    }

    // 1b. Non-PII Booking Status Projection (customer lookup by exact Booking ID only, no listing):
    match /booking_status/{bookingId} {
      allow create: if isValidId(bookingId)
        && isValidBookingStatus(incoming())
        && incoming().id == bookingId
        && (
          isAdmin() ||
          (
            incoming().status == 'new'
            && incoming().paymentAllowed == false
            && incoming().eligibilityStatus == 'pending_instructor_review'
          )
        );
      allow get: if isValidId(bookingId);
      allow update: if isValidId(bookingId) && isAdmin() && isValidBookingStatus(incoming());
      allow delete: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();
    }

    // 2. Settings Collection:
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // 3. Admin Whitelist (/admins collection):
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && (
        isAdmin() ||
        (
          isSuperAdmin()
          && request.auth.uid == adminId 
          && isValidAdminRecord(incoming())
        )
      );
      allow update: if isValidId(adminId) && (
        isAdmin() ||
        (isSuperAdmin() && request.auth.uid == adminId && isValidAdminRecord(incoming()))
      );
      allow delete: if isValidId(adminId) && isAdmin() && (
        resource.data.email == null || (
          resource.data.email != 'azozsindi23@gmail.com' &&
          resource.data.email != 'AzozSindi23@gmail.com'
        )
      );
    }

    // 4. Trainees & Students (/trainees collection):
    match /trainees/{traineeId} {
      allow create, update: if isValidId(traineeId) && isAdmin() && isValidTrainee(incoming()) && incoming().id == traineeId;
      allow get, delete: if isValidId(traineeId) && isAdmin();
      allow list: if isAdmin();
    }
  }
}
