rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Root Super Admin Gate:
    // Strictly requires email: azozsindi23@gmail.com (case-insensitive)
    function isSuperAdmin() {
      return isSignedIn() 
        && request.auth.token.email != null 
        && request.auth.token.email.matches('(?i)^azozsindi23@gmail\\.com$');
    }

    // General Admin Gate:
    // 1. Root Super Admin (azozsindi23@gmail.com)
    // 2. Firebase Custom Claims (admin == true)
    // 3. Explicit document in /admins/{uid} with role admin or superadmin
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        )
      );
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'interest', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && data.interest is string && data.interest.size() <= 200
        && (!('experience' in data) || (data.experience is string && data.experience.size() <= 100))
        && (!('timing' in data) || (data.timing is string && data.timing.size() <= 100))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.status in ['new', 'contacted', 'confirmed', 'completed', 'cancelled', 'paid', 'pending_payment']
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.email is string && data.email.size() <= 150
        && data.role in ['superadmin', 'admin', 'instructor', 'viewer']
        && (!('name' in data) || (data.name is string && data.name.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('status' in data) || (data.status in ['active', 'suspended']))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 50));
    }

    function isValidTrainee(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('course' in data) || (data.course is string && data.course.size() <= 200))
        && (!('status' in data) || (data.status in ['active', 'completed', 'pending', 'paused']))
        && (!('padiNumber' in data) || (data.padiNumber is string && data.padiNumber.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    // 1. Bookings collection:
    // - Public site visitors can create their own consultation or course booking.
    // - ONLY verified admins can view, update status, or delete bookings!
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId) 
        && isValidBooking(incoming()) 
        && incoming().id == bookingId;
      allow read, update, delete: if isValidId(bookingId) && isAdmin();
    }

    // 2. Public & Admin Settings:
    // - Public site visitors can read website settings (course details, prices, contact info).
    // - ONLY verified admins can modify or write settings!
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId) && isAdmin();
    }

    // 3. Admin whitelist (/admins collection):
    // - Signed-in users can check their own admin status.
    // - Verified Admins can add or update admin and team records.
    // - First-time logging-in users can link their authorized UID record.
    // - The root superadmin record cannot be deleted.
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && (
        isAdmin() ||
        (
          isSignedIn() 
          && request.auth.uid == adminId 
          && isValidAdminRecord(incoming())
          && (
            (incoming().email != null && incoming().email.matches('(?i)^azozsindi23@gmail\\.com$')) ||
            (request.auth.token.email != null && incoming().email == request.auth.token.email)
          )
        )
      );
      allow update: if isValidId(adminId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.uid == adminId && isValidAdminRecord(incoming()))
      );
      allow delete: if isValidId(adminId) && isAdmin() && (
        resource.data.email == null || !resource.data.email.matches('(?i)^azozsindi23@gmail\\.com$')
      );
    }

    // 4. Trainees & Students (/trainees collection):
    // - ONLY verified admins can manage registered trainees and students.
    match /trainees/{traineeId} {
      allow create, update: if isValidId(traineeId) && isAdmin() && isValidTrainee(incoming()) && incoming().id == traineeId;
      allow read, delete: if isValidId(traineeId) && isAdmin();
    }
  }
}
